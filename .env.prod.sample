##### GEMINI LLM ######
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"
GEMINI_MODEL="gemini-2.0-flash"

##### PROMPT ######
PROMPT_VERSION=3

##### LANCEDB / EMBEDDINGS ######
LANCEDB_URI=".lancedb"
DESTINATION__LANCEDB__EMBEDDING_MODEL_PROVIDER="sentence-transformers"
DESTINATION__LANCEDB__EMBEDDING_MODEL="all-MiniLM-L6-v2"
DESTINATION__LANCEDB__CREDENTIALS__URI=".lancedb"

##### RAG ######
RAG_TOP_K=10
CHUNK_SIZE=900
CHUNK_OVERLAP=50

##### PHOENIX TRACING ######
PHOENIX_PROJECT_NAME="diveroast"
# PHOENIX_COLLECTOR_ENDPOINT and PHOENIX_CLIENT_ENDPOINT are set in docker-compose.prod.yml

##### CORS (must match your domain) ######
ALLOWED_ORIGINS="https://diveroast.app,https://www.diveroast.app"

##### STORAGE ######
# Snapshots and donations use named Docker volumes — paths below are inside the container
SNAPSHOT_DIR="/tmp/diveroast-snapshots"
DONATIONS_DIR="/tmp/diveroast-donations"
