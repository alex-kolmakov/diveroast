##### GEMINI LLM ######
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

##### LOCAL LLM (optional — replaces Gemini when LLM_BASE_URL is set) ######
# LLM_BASE_URL="http://localhost:1234/v1"  # LM Studio / any OpenAI-compatible server
# LLM_MODEL="qwen/qwen3-30b-a3b"

##### AGENT ######
AGENT_MAX_STEPS=8  # tool rounds per message before the model must answer
AGENT_TOOL_TEMPERATURE=0.2
AGENT_TEMPERATURE=0.8
SESSION_TTL_SECONDS=21600
MAX_SESSIONS=500

##### COST AND ABUSE GUARDS ######
CHAT_MAX_OUTPUT_TOKENS=2048  # per model call, thinking included
SUMMARY_MAX_OUTPUT_TOKENS=2048  # the worst-dive jabs
# Thinking (counts against the caps). For gemini-3.6-flash: LOW for chat,
# MINIMAL for the summaries; empty = the model's default.
# THINKING_LEVEL=LOW
# SUMMARY_THINKING_LEVEL=MINIMAL
SESSION_MAX_MESSAGES=30
SESSION_MAX_TOKENS=1000000  # one roast on a ~200-dive log is ~20k
DAILY_MAX_TOKENS=20000000  # all sessions, UTC day; chat pauses when spent
UPLOADS_PER_IP_PER_HOUR=60  # generous: a venue or office shares one IP
CHATS_PER_IP_PER_HOUR=300
MODEL_RETRY_BASE_SECONDS=2  # backoff on 429/5xx: 2 s, then 6 s
# TRUST_PROXY_HEADERS=true  # only behind the production nginx (set in docker-compose.prod.yml)

##### LANCEDB / EMBEDDINGS ######
LANCEDB_URI=".lancedb"
DESTINATION__LANCEDB__EMBEDDING_MODEL_PROVIDER="sentence-transformers"
DESTINATION__LANCEDB__EMBEDDING_MODEL="all-MiniLM-L6-v2"
DESTINATION__LANCEDB__CREDENTIALS__URI=".lancedb"

##### RAG ######
RAG_TOP_K=10
CHUNK_SIZE=900
CHUNK_OVERLAP=50
RAG_MIN_RELEVANCE=-5.0  # cross-encoder logit floor (reranking only)
RAG_MIN_ROWS=10000  # a full rebuild below this fails
RAG_REBUILD_MIN_RATIO=0.8  # ...or below this fraction of the previous table

##### SENTRY (errors only; off when empty) ######
# SENTRY_DSN="https://...@o0.ingest.sentry.io/..."      # backend project
# SENTRY_DSN_FRONTEND="https://...@o0.ingest.sentry.io/..."  # frontend project, baked in at build
# SENTRY_ENVIRONMENT="production"

##### PHOENIX TRACING ######
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006/v1/traces"
PHOENIX_PROJECT_NAME="diveroast"
